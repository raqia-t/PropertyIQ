# Phase 3 — Ollama hybrid search parser
# Phase 8 — start-dev ensures Ollama before AI; parse logs → services/ai/logs/search-parser.jsonl
AI_PARSER_MODE=hybrid
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=150
AI_PARSER_MIN_CONFIDENCE=0.55
# Phase A — agent listing draft (hybrid = Ollama then template)
AI_LISTING_DRAFT_MODE=hybrid
# Phase B — optional Ollama narrative over locked comps numbers (hybrid|off)
AI_SCENARIO_EXPLAIN=hybrid
AI_SCENARIO_EXPLAIN_TIMEOUT_SEC=8
# Phase C — photo classification (needs a vision model, e.g. llava:7b)
AI_IMAGE_CLASSIFY_MODE=hybrid
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_VISION_TIMEOUT_SEC=180
# Phase D — agent daily brief + optimizer polish (hybrid|rules|off)
AI_AGENT_OPS_MODE=hybrid
AI_AGENT_OPS_TIMEOUT_SEC=12
